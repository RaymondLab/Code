'--------------------------------------------------------------------------------
' IMPORT RIG-SPECIFIC PARAMETERS AND UNIVERSAL PARAMETERS
'--------------------------------------------------------------------------------
#include "C:\\Users\\Public\\RaymondLabCode\\Experiment Protocols\\RigChoice.s2s"
#include "C:\\Users\\Public\\RaymondLabCode\\Experiment Protocols\\Parameters_UniversalAlex.s2s"

'--------------------------------------------------------------------------------
' MAIN PROGRAM
'--------------------------------------------------------------------------------
' 0 = GAP
' 2 = test
' 3 = train
' 9 = quit experiment

const Order%[] := {0, 2,
                   0, 2,
                   0, 2,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   1, 3, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3,
                   0, 2,
                   0, 2,
                   0, 2,
                   0, 4};

var expmtIndx := 0;
runLength := 10.5;
testLength := 60;
var ITIvector[7];

ToolbarConfig();

'--------------------------------------------------------------------------------
' Toolbar Callbacks
'--------------------------------------------------------------------------------
Func ToolbarIdle%()
  'This function calls repeatedly whenever nothing else is happening
  'if runexpmt=1, it is used to run a full expmt automatically.  -HP
  'expmtMode: 0=habit, 1=0x, 2=2x, 3=ipsi stim, 4=contra stim
  'test: 0=wait, 1=test, 2=train

  ' Check a valid sampling view is running
  var currView := ViewKind();
  if  currView <> 0 then
      return 1;
  endif;

  ' Keep sine wave from drifting
  if MaxTime() > (prevTime + 1/((stepPeriod+QueTime)/1000)) then
    if driftFix = 1 then
      driftFix%();
    endif;
  endif;


  'If an experiment is running:
  if runExpmt% = 1 then

      'Check the time. Seconds is the current time - compare it to the goal time of each segment
      if  MaxTime() > goalTime then

        SampleKey(str$(Order%[expmtIndx]));
        docase
          ' GAP
          case Order%[expmtIndx] = 0 then
            SampleKey("x");
            goalTime := MaxTime() + 10;
            ToolbarInit%(); Yield();
            
          case Order%[expmtIndx] = 1 then
            SampleKey("r");
            goalTime := MaxTime() + (ITIvector[currITIidx%]*1000);
            currITIidx% := currITIidx% + 1;
            ToolbarInit%(); Yield();

          ' TEST
          case Order%[expmtIndx] = 2 then
            SampleKey("X");
            goalTime := MaxTime() + testLength;
            stepPeriod := 2000;
            stepLength := 495;
            stepAmpChair := 10;
            stepAmpDrumN := 0;
            stepAmpDrum := 0;
            ToolbarStepConfig%(); Yield();
            toolbarStepOn%(); Yield();


          ' TRAIN
          case Order%[expmtIndx] = 3 then
            SampleKey("X");
            goalTime := MaxTime() + runLength;
            stepPeriod := 10000;
            stepLength := 4995;
            stepLen1 := 100;
            stepAmpChair := 0;
            stepAmpDrum := -10;
            stepAmpDrumN := 10.02;
            QueTime := 495;
            ToolbarStepConfig%(); Yield();
            toolbarStepOn%(); Yield();

          ' QUIT EXPMT
          case Order%[expmtIndx] = 4 then
            ToolbarQuitExpmt%();
            Return(1);

        endcase;
        expmtIndx := expmtIndx + 1;
      endif;
  endif;
  Return(1);
End

'--------------------------------------------------------------------------------
'Configure expmt settings window
'--------------------------------------------------------------------------------
Func ToolbarConfigExpmt%()
  DlgCreate("Experiment settings");  'Start new dialog
  DlgReal(1,"Run length (s)",0,5000);
  DlgReal(2,"Test length (s)",0,5000);
  
  DlgShow(runLength, testLength);
  fillITIvector%();
  SetSequencerValues();
  Return(1);
End

Func fillITIvector%()
  randomizeITIvector();
  PrintLog(ITIvector);
  Return(1);
End

Proc randomizeITIvector()
  var i%;
  var swapIdx%;
  var tmp;
  for i% := numITIs%-1 to 0 step -1 do
      swapIdx% := Floor(Rand(i%+1),0);'swapIdx% := Floor(Rand(i%+1, 0));
      tmp := ITIvector[swapIdx%];
      ITIvector[swapIdx%] := ITIvector[i%];
      ITIvector[i%] := tmp;
  next;
End